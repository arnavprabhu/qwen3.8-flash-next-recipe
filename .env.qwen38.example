# Configuration for Qwen3.8-Flash-Next server
# Hardware requirement: Apple Silicon Mac (64 GB+ Unified Memory)

# Network configuration
HOST="${HOST:-127.0.0.1}"
PORT="${PORT:-9999}"

# Model paths
MODEL_DIR="${MODEL_DIR:-models/Qwen3.8-Flash-Next-AD-3.84bpw-IQ4_XS-M64}"
MODEL_FILE="${MODEL_FILE:-Qwen3.8-Flash-Next-AD-3.84bpw-IQ4_XS-M64-00001-of-00028.gguf}"
MODEL_PATH="${MODEL_PATH:-${MODEL_DIR}/${MODEL_FILE}}"
MODEL_ALIAS="${MODEL_ALIAS:-qwen3.8-flash-next}"

# llama.cpp server binary
LLAMA_SERVER_BIN="${LLAMA_SERVER_BIN:-llama.cpp/build/bin/llama-server}"

# Context and hardware options
# Context size set to 200K (204800 tokens)
CTX_SIZE="${CTX_SIZE:-204800}"
N_GPU_LAYERS="${N_GPU_LAYERS:-99}"
LOAD_MODE="${LOAD_MODE:-mmap}"
FIT="${FIT:-off}"
FLASH_ATTN="${FLASH_ATTN:-on}"
JINJA="${JINJA:-true}"

# Qwen-recommended sampling defaults
TEMPERATURE="${TEMPERATURE:-1.0}"
TOP_P="${TOP_P:-0.95}"
TOP_K="${TOP_K:-20}"
MIN_P="${MIN_P:-0}"

# Logging and PID tracking
LOG_DIR="${LOG_DIR:-logs}"
LOG_FILE="${LOG_FILE:-${LOG_DIR}/qwen38.log}"
PID_FILE="${PID_FILE:-${LOG_DIR}/qwen38.pid}"

# Extra arguments for llama-server: n-gram self-speculative decoding and prometheus metrics
EXTRA_ARGS="${EXTRA_ARGS:---spec-type ngram-mod --metrics}"
